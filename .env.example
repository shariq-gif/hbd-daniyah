# ---- Visit tracking / logs -------------------------------------------------
# Copy to .env.local for local dev, and set these in Vercel → Project → Settings
# → Environment Variables for production.

# Password for the /logs admin dashboard. CHANGE THIS.
TRACKER_PASSWORD=pick-a-strong-password

# Persistent store for visits (needed on Vercel — its filesystem is temporary).
# Easiest: Vercel → Storage → create an Upstash Redis (KV) database and "Connect
# to Project". That auto-injects the vars below — you don't type them by hand.
#
# The app accepts either the Vercel KV names OR the Upstash names:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
#
# With no store configured, tracking still runs but only keeps data in memory
# (fine for local testing; resets constantly on serverless).
